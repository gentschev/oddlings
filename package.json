{
  "name": "oddlings",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --port 5199 --host",
    "preview": "vite preview --port 5199 --host",
    "build": "tsc --noEmit && vite build && node tools/check-build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "node tools/screens.mjs",
    "speech:lines": "node tools/export-speech-lines.mjs",
    "speech:check": "node tools/speech/tails.mjs public/assets/speech",
    "lint": "tsc --noEmit && eslint ."
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^3.2.0"
  }
}
